"""FastAPI entry point for the AI-Powered Amount Detection service."""

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from app.routers import ocr, normalize, classify, pipeline
import logging

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Create FastAPI application
app = FastAPI(
    title="AI-Powered Amount Detection Service",
    description="""
    A comprehensive service for extracting, normalizing, and classifying financial amounts 
    from medical documents (bills, receipts) using OCR and context analysis.
    
    ## Features
    
    * **OCR Processing**: Extract numeric tokens from text or images
    * **Normalization**: Fix OCR errors and convert to clean numeric values  
    * **Classification**: Label amounts by context (total, paid, due, etc.)
    * **Full Pipeline**: End-to-end processing with confidence scoring
    
    ## Pipeline Steps
    
    1. **OCR/Text Extraction** - Extract raw numeric tokens
    2. **Normalization** - Fix OCR digit errors (l→1, O→0, etc.)
    3. **Classification** - Use context clues to label amount types
    4. **Final Output** - Return structured JSON with provenance
    """,
    version="1.0.0",
    contact={
        "name": "Amount Detection Service",
        "email": "support@example.com",
    },
)

# Add CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # Configure appropriately for production
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Include API routers
app.include_router(ocr.router)
app.include_router(normalize.router)
app.include_router(classify.router)
app.include_router(pipeline.router)


@app.get("/", tags=["root"])
async def root():
    """Welcome endpoint with service information."""
    return {
        "message": "Welcome to the AI-Powered Amount Detection Service",
        "description": "Extract and classify financial amounts from medical documents",
        "version": "1.0.0",
        "docs_url": "/docs",
        "endpoints": {
            "pipeline": "/pipeline/detect - Full end-to-end processing",
            "ocr": "/ocr/extract - Text/token extraction only", 
            "normalize": "/normalize/fix - Amount normalization only",
            "classify": "/classify/label - Amount classification only"
        }
    }


@app.get("/health", tags=["health"])
async def health_check():
    """Health check endpoint."""
    return {
        "status": "healthy",
        "service": "amount-detector",
        "version": "1.0.0"
    }
